{
  "name": "PDIA Workspace",
  "short_name": "PDIA",
  "description": "Problem-Driven Iterative Adaptation workspace: define problems, find root causes, iterate and track.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f0f2f5",
